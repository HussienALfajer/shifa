# Local development only: copy to .env (git-ignored) and fill in your own values.
# Keys are validated by src/config/env.ts; a misspelt key stops the API at start-up.

# PostgreSQL as the application role (shifa_app); createDb() refuses owner or superuser roles.
DATABASE_URL=postgres://shifa_app:<local-password>@127.0.0.1:5432/shifa
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# Telemetry (0.2-09b). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to run with no telemetry at all.
# With the local stack (`pnpm obs:up`, 0.2-09b3) the Collector listens for OTLP/HTTP here:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER_ARG=1
DEPLOYMENT_ENVIRONMENT=development

# Error reporting (0.2-09b2). Leave SENTRY_DSN unset to run without the Sentry SDK at all. With the
# local stack, copy the DSN of the GlitchTip project (always a 127.0.0.1 address), e.g.:
# SENTRY_DSN=http://<public-key>@127.0.0.1:8000/1
# Defaults to the package version (e.g. 0.0.0):
# SENTRY_RELEASE=0.0.0
# NODE_ENV=test registers the test-only failing route GET /_test/fail; never set it elsewhere.
