{
  "name": "shifa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs fast",
    "verify:full": "node scripts/verify.mjs full",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:instructions": "node scripts/check-instruction-size.mjs",
    "env:check": "node scripts/env-check.mjs",
    "obs:up": "node scripts/obs.mjs up",
    "obs:down": "node scripts/obs.mjs down",
    "obs:reset": "node scripts/obs.mjs reset",
    "obs:smoke": "node scripts/obs.mjs smoke",
    "backup:up": "node scripts/backup.mjs up",
    "backup:down": "node scripts/backup.mjs down",
    "backup:reset": "node scripts/backup.mjs reset",
    "backup:full": "node scripts/backup.mjs full",
    "backup:diff": "node scripts/backup.mjs diff",
    "backup:check": "node scripts/backup.mjs check",
    "backup:restore": "node scripts/backup.mjs restore",
    "backup:drill": "node scripts/backup.mjs drill"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/js": "10.0.1",
    "@shifa/eslint-config": "workspace:*",
    "@shifa/tsconfig": "workspace:*",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
