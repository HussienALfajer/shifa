{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".fvmrc", "pubspec.yaml", "pubspec.lock", "analysis_options.yaml"],
  "globalPassThroughEnv": ["SHIFA_FLUTTER_ROOT", "PUB_CACHE", "LOCALAPPDATA", "APPDATA"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tooling/eslint-config/**",
        "$TURBO_ROOT$/packages/tokens/generated/css/tailwind-theme.css"
      ]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/lib/lock.mjs",
        "$TURBO_ROOT$/scripts/lib/font-rename.mjs",
        "$TURBO_ROOT$/scripts/lib/fonts.mjs",
        "$TURBO_ROOT$/docs/brand/logo/**",
        "$TURBO_ROOT$/packages/tokens/fonts/**",
        "$TURBO_ROOT$/packages/tokens/generated/**"
      ],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_CONFIG",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_*",
        "RYUK_CONTAINER_IMAGE",
        "HOME",
        "USERPROFILE"
      ]
    }
  }
}
