{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "test/**", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "test/**", "eslint.config.*", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "test/**", "vitest.config.*", "package.json"]
    }
  }
}
