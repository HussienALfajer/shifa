{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".fvmrc", "pubspec.yaml", "pubspec.lock", "analysis_options.yaml"],
  "globalPassThroughEnv": ["SHIFA_FLUTTER_ROOT", "PUB_CACHE", "LOCALAPPDATA", "APPDATA"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/lib/lock.mjs"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CONTEXT",
        "DOCKER_CONFIG",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_*",
        "RYUK_CONTAINER_IMAGE",
        "HOME",
        "USERPROFILE"
      ]
    }
  }
}
