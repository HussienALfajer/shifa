{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!docs/brand/**",
      "!pnpm-lock.yaml",
      "!**/migrations/*/snapshot.json",
      "!**/generated/**",
      "!spikes/s6-voice/analysis/test/__snapshots__/**",
      "!spikes/s6-voice/manifests/**",
      "!spikes/s6-voice/results/**",
      "!spikes/s7-push/runs/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["packages/tokens/src/**/*.tokens.json"],
      "formatter": { "lineWidth": 160 }
    }
  ],
  "linter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
