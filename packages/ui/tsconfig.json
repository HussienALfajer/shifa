{
  "extends": "@shifa/tsconfig/library.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    // Bundled by Vite (Storybook, the apps). Bundler resolution also reads packages whose
    // declaration files use extension-less relative imports.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "screenshots", ".storybook/**/*", "*.config.ts"]
}
