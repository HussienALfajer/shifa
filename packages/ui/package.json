{
  "name": "@shifa/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shifa's web components: UI SDK behaviours with Shifa styling, semantic tokens only (spec 0.4, ADR-0039).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "screenshots": "node scripts/screenshots.ts",
    "design-system:build": "node scripts/design-system/build.ts",
    "components:check": "node scripts/design-system/canvas/check.ts",
    "components:canvas": "node scripts/design-system/canvas/canvas.ts",
    "icons:sync": "node scripts/icons-sync.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.7",
    "@shifa/contracts": "workspace:*",
    "@shifa/tokens": "workspace:*",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/solar": "1.2.17",
    "@playwright/test": "1.65.1",
    "@shifa/eslint-config": "workspace:*",
    "@shifa/testing": "workspace:*",
    "@shifa/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.1",
    "eslint": "10.14.0",
    "playwright": "1.65.1",
    "postcss": "8.5.32",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
