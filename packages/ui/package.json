{
  "name": "@shifa/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shifa's web components: UI SDK behaviours with Shifa styling, semantic tokens only (spec 0.4, ADR-0039).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tailwind.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@shifa/tokens": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@shifa/eslint-config": "workspace:*",
    "@shifa/tsconfig": "workspace:*",
    "@tailwindcss/node": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
