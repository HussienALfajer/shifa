    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-router": "1.170.46",
    "@vitejs/plugin-react": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@shifa/contracts": "workspace:*",
    "@shifa/eslint-config": "workspace:*",
    "@shifa/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
