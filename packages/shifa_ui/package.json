{
  "name": "@shifa/dart-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Turborepo task wrapper for the Flutter package shifa_ui (see pubspec.yaml).",
  "scripts": {
    "generate": "node ../../scripts/check-drift.mjs --fix",
    "typecheck": "node ../../scripts/dart.mjs dart analyze --fatal-infos",
