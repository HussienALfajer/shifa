{
  "$description": "Scales of the Warm design language, chosen by the owner on 2026-11-20 (OD-57, docs/architecture/design-system.md): rounder shapes, a 1.25 type scale, one small soft shadow, 150–240 ms motion.",
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "0-5": { "$value": { "value": 2, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "7": { "$value": { "value": 28, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "9": { "$value": { "value": 36, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "11": { "$value": { "value": 44, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "13": { "$value": { "value": 52, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "thin": { "$value": { "value": 1, "unit": "px" } },
      "thick": { "$value": { "value": 2, "unit": "px" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["IBM Plex Sans Arabic", "system-ui", "sans-serif"] },
      "serif": { "$value": ["Noto Naskh Arabic", "serif"] },
      "mono": { "$value": ["ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Ratio 1.25 from 16 px (20, 25, 31), with fixed small steps. Data text never goes below 200 (14 px); 100 is for captions only.",
      "100": { "$value": { "value": 12, "unit": "px" } },
      "200": { "$value": { "value": 14, "unit": "px" } },
      "250": { "$value": { "value": 15, "unit": "px" } },
      "300": { "$value": { "value": 16, "unit": "px" } },
      "400": { "$value": { "value": 18, "unit": "px" } },
      "500": { "$value": { "value": 20, "unit": "px" } },
      "600": { "$value": { "value": 25, "unit": "px" } },
      "700": { "$value": { "value": 31, "unit": "px" } },
      "800": { "$value": { "value": 44, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.3 },
      "normal": { "$value": 1.6 },
      "relaxed": { "$value": 1.8 }
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Small, cheap shadows: readable without them on low-end clinic PCs.",
    "1": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.1137, 0.1647, 0.149], "alpha": 0.08, "hex": "#1d2a26" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "2": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.1137, 0.1647, 0.149], "alpha": 0.12, "hex": "#1d2a26" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": -2, "unit": "px" }
      }
    },
    "3": {
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.1137, 0.1647, 0.149], "alpha": 0.16, "hex": "#1d2a26" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 20, "unit": "px" },
        "spread": { "value": -4, "unit": "px" }
      }
    },
    "focus": {
      "$description": "A soft green halo outside the 2 px focus outline; it softens the ring, the outline carries the contrast.",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.1216, 0.4353, 0.3608], "alpha": 0.24, "hex": "#1f6f5c" },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur": { "value": 0, "unit": "px" },
        "spread": { "value": 4, "unit": "px" }
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Principle 6: 240 ms at most. fast: hover and press; base: popovers; slow: dialogs and sheets. Reduced motion turns them off in the components.",
      "fast": { "$value": { "value": 150, "unit": "ms" } },
      "base": { "$value": { "value": 200, "unit": "ms" } },
      "slow": { "$value": { "value": 240, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0, 0, 0.2, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 100 },
    "dropdown": { "$value": 200 },
    "overlay": { "$value": 300 },
    "modal": { "$value": 400 },
    "popover": { "$value": 500 },
    "toast": { "$value": 600 },
    "tooltip": { "$value": 700 }
  }
}
