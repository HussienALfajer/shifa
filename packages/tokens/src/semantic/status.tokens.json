{
  "color": {
    "$type": "color",
    "status": {
      "$description": "Locked: one meaning everywhere, no clinic theme changes them, never the only signal (icon or label too). Red (crimson) is for clinical alerts only; danger is brick.",
      "success": {
        "fg": { "$value": "{color.signal.green.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.300}" } } } },
        "bg": { "$value": "{color.signal.green.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.900}" } } } },
        "border": { "$value": "{color.signal.green.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.800}" } } } },
        "solid": { "$value": "{color.signal.green.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "warning": {
        "fg": { "$value": "{color.signal.amber.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.300}" } } } },
        "bg": { "$value": "{color.signal.amber.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.900}" } } } },
        "border": { "$value": "{color.signal.amber.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.800}" } } } },
        "solid": { "$value": "{color.signal.amber.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "danger": {
        "fg": { "$value": "{color.signal.brick.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.300}" } } } },
        "bg": { "$value": "{color.signal.brick.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.900}" } } } },
        "border": { "$value": "{color.signal.brick.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.800}" } } } },
        "solid": { "$value": "{color.signal.brick.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "info": {
        "fg": { "$value": "{color.signal.blue.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.300}" } } } },
        "bg": { "$value": "{color.signal.blue.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.900}" } } } },
        "border": { "$value": "{color.signal.blue.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.800}" } } } },
        "solid": { "$value": "{color.signal.blue.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "neutral": {
        "fg": { "$value": "{color.signal.slate.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.300}" } } } },
        "bg": { "$value": "{color.signal.slate.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.900}" } } } },
        "border": { "$value": "{color.signal.slate.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.800}" } } } },
        "solid": { "$value": "{color.signal.slate.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      }
    },
    "sync": {
      "$description": "Saved, offline and syncing: the record state a user must always see (principle 2).",
      "saved": {
        "fg": { "$value": "{color.signal.green.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.300}" } } } },
        "bg": { "$value": "{color.signal.green.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.900}" } } } }
      },
      "offline": {
        "fg": { "$value": "{color.signal.slate.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.300}" } } } },
        "bg": { "$value": "{color.signal.slate.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.900}" } } } }
      },
      "syncing": {
        "fg": { "$value": "{color.signal.blue.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.300}" } } } },
        "bg": { "$value": "{color.signal.blue.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.900}" } } } }
      }
    },
    "alert": {
      "$description": "Clinical alert severities. Critical is the only red in the product.",
      "info": {
        "fg": { "$value": "{color.signal.blue.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.300}" } } } },
        "bg": { "$value": "{color.signal.blue.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.900}" } } } },
        "border": { "$value": "{color.signal.blue.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.800}" } } } },
        "solid": { "$value": "{color.signal.blue.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "warning": {
        "fg": { "$value": "{color.signal.amber.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.300}" } } } },
        "bg": { "$value": "{color.signal.amber.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.900}" } } } },
        "border": { "$value": "{color.signal.amber.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.800}" } } } },
        "solid": { "$value": "{color.signal.amber.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      },
      "critical": {
        "fg": { "$value": "{color.signal.crimson.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.crimson.300}" } } } },
        "bg": { "$value": "{color.signal.crimson.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.crimson.900}" } } } },
        "border": { "$value": "{color.signal.crimson.200}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.crimson.800}" } } } },
        "solid": { "$value": "{color.signal.crimson.600}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.crimson.400}" } } } },
        "on-solid": { "$value": "{color.white}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.jasmine.night.950}" } } } }
      }
    },
    "queue": {
      "$description": "Visit statuses of SCH-18: booked → confirmed → arrived → waiting → in room → done; exits no-show and cancelled.",
      "booked": {
        "fg": { "$value": "{color.signal.slate.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.300}" } } } },
        "bg": { "$value": "{color.signal.slate.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.slate.900}" } } } }
      },
      "confirmed": {
        "fg": { "$value": "{color.signal.blue.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.300}" } } } },
        "bg": { "$value": "{color.signal.blue.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.blue.900}" } } } }
      },
      "arrived": {
        "fg": { "$value": "{color.signal.cyan.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.cyan.300}" } } } },
        "bg": { "$value": "{color.signal.cyan.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.cyan.900}" } } } }
      },
      "waiting": {
        "fg": { "$value": "{color.signal.amber.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.300}" } } } },
        "bg": { "$value": "{color.signal.amber.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.amber.900}" } } } }
      },
      "in-room": {
        "fg": { "$value": "{color.signal.violet.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.violet.300}" } } } },
        "bg": { "$value": "{color.signal.violet.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.violet.900}" } } } }
      },
      "done": {
        "fg": { "$value": "{color.signal.green.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.300}" } } } },
        "bg": { "$value": "{color.signal.green.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.green.900}" } } } }
      },
      "no-show": {
        "fg": { "$value": "{color.signal.brick.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.300}" } } } },
        "bg": { "$value": "{color.signal.brick.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.brick.900}" } } } }
      },
      "cancelled": {
        "fg": { "$value": "{color.signal.sand.700}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.sand.300}" } } } },
        "bg": { "$value": "{color.signal.sand.50}", "$extensions": { "shifa": { "locked": true, "modes": { "dark": "{color.signal.sand.900}" } } } }
      }
    }
  }
}
