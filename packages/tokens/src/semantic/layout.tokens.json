{
  "size": {
    "$type": "dimension",
    "$description": "Two densities (principle 3): comfortable for touch (44 px targets), compact for desktop data screens (32 px rows).",
    "control": {
      "sm": { "$value": "{space.9}", "$extensions": { "shifa": { "modes": { "compact": "{space.7}" } } } },
      "md": { "$value": "{space.11}", "$extensions": { "shifa": { "modes": { "compact": "{space.8}" } } } },
      "lg": { "$value": "{space.13}", "$extensions": { "shifa": { "modes": { "compact": "{space.10}" } } } }
    },
    "row": { "$value": "{space.12}", "$extensions": { "shifa": { "modes": { "compact": "{space.8}" } } } },
    "target-min": { "$value": "{space.11}" },
    "icon": {
      "$description": "Phosphor icons, duotone: sm in rows and controls, md in navigation and cards.",
      "sm": { "$value": "{space.5}" },
      "md": { "$value": "{space.6}" }
    }
  },
  "inset": {
    "$type": "dimension",
    "control": { "$value": "{space.4}", "$extensions": { "shifa": { "modes": { "compact": "{space.3}" } } } },
    "surface": { "$value": "{space.6}", "$extensions": { "shifa": { "modes": { "compact": "{space.4}" } } } }
  },
  "gap": {
    "$type": "dimension",
    "stack": { "$value": "{space.4}", "$extensions": { "shifa": { "modes": { "compact": "{space.2}" } } } },
    "inline": { "$value": "{space.2}" }
  },
  "text": {
    "family": {
      "$type": "fontFamily",
      "ui": { "$value": "{font.family.sans}" },
      "reading": { "$value": "{font.family.serif}" },
      "code": { "$value": "{font.family.mono}" }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": "{font.size.100}" },
      "data": { "$value": "{font.size.250}", "$extensions": { "shifa": { "modes": { "compact": "{font.size.200}" } } } },
      "body": { "$value": "{font.size.300}", "$extensions": { "shifa": { "modes": { "compact": "{font.size.250}" } } } },
      "body-lg": { "$description": "Body text on the phone and long reading text.", "$value": "{font.size.400}" },
      "heading-sm": { "$value": "{font.size.500}" },
      "heading-md": { "$value": "{font.size.600}" },
      "heading-lg": { "$value": "{font.size.700}" },
      "display": { "$description": "Queue numbers and other large numerals.", "$value": "{font.size.800}" }
    },
    "weight": {
      "$type": "fontWeight",
      "body": { "$value": "{font.weight.regular}" },
      "label": { "$value": "{font.weight.medium}" },
      "heading": { "$value": "{font.weight.semibold}" },
      "display": { "$value": "{font.weight.bold}" }
    },
    "leading": {
      "$type": "number",
      "body": { "$value": "{font.line-height.normal}" },
      "heading": { "$value": "{font.line-height.tight}" },
      "reading": { "$value": "{font.line-height.relaxed}" }
    }
  },
  "shape": {
    "$type": "dimension",
    "radius": {
      "mark": { "$description": "Checkboxes and other small marks.", "$value": "{radius.xs}" },
      "input": { "$description": "Inputs and chips.", "$value": "{radius.sm}" },
      "control": { "$description": "Buttons.", "$value": "{radius.md}" },
      "surface": { "$description": "Cards.", "$value": "{radius.md}" },
      "overlay": { "$description": "Dialogs, sheets and popovers.", "$value": "{radius.lg}" },
      "pill": { "$description": "Status pills and round badges.", "$value": "{radius.full}" }
    },
    "border": {
      "default": { "$value": "{border.width.thin}" },
      "focus": { "$value": "{border.width.thick}" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Named by job. A card also has a border, which carries it in the dark theme.",
    "card": { "$value": "{elevation.1}" },
    "dropdown": { "$value": "{elevation.2}" },
    "raised": { "$value": "{elevation.1}" },
    "overlay": { "$value": "{elevation.2}" },
    "modal": { "$value": "{elevation.3}" }
  }
}
