{
  "version": 2,
  "description": "Shared Arabic name-search key vectors (ADR-0034, ADR-0052; key version 2, OD-145). Both normaliser ports (TypeScript in @shifa/contracts, Dart in shifa_name_key) and the SQL drift check must give `key` for `input`. Synthetic names only. Version 1 is the spike S3 file.",
  "rules": [
    {
      "id": "nfc",
      "description": "Unicode NFC first (and once more at the end, after removals)."
    },
    {
      "id": "tashkeel",
      "description": "Remove U+064B–065F, U+0670 and Quranic marks U+06D6–06ED."
    },
    {
      "id": "tatweel",
      "description": "Remove tatweel U+0640."
    },
    {
      "id": "format",
      "description": "Remove every format character (Unicode category Cf: bidi controls U+200E, U+200F, U+202A–202E, U+2066–2069, ALM U+061C, word joiner U+2060, soft hyphen, tags …) except ZWSP, ZWNJ, ZWJ and BOM, which are spaces (OD-145)."
    },
    {
      "id": "alef",
      "description": "Fold أ إ آ ٱ to ا."
    },
    {
      "id": "hamza-carrier",
      "description": "Fold ؤ to و and ئ to ي."
    },
    {
      "id": "teh-marbuta",
      "description": "ة → ه when not followed by an Arabic letter."
    },
    {
      "id": "alef-maksura",
      "description": "ى → ي when not followed by an Arabic letter."
    },
    {
      "id": "digits",
      "description": "Arabic-Indic U+0660–0669 and Persian U+06F0–06F9 digits → 0–9."
    },
    {
      "id": "latin",
      "description": "Upper-case and title-case letters of Basic Latin, Latin-1 Supplement, Latin Extended-A and -B, Latin Extended Additional and full-width Latin lower-cased by the Unicode default mapping, without locale rules; İ (U+0130) → i (OD-145, amends OD-40's ASCII-only rule). Latin Extended-C and -D stay as typed."
    },
    {
      "id": "whitespace",
      "description": "Unicode spaces, ZWSP, ZWNJ, ZWJ and BOM → one space; trimmed."
    },
    {
      "id": "particle",
      "description": "عبد ابو ابي ام ابن بن بنت joined with the next word (two passes)."
    },
    {
      "id": "interaction",
      "description": "Several rules on one input."
    },
    {
      "id": "passthrough",
      "description": "Inputs no rule may change."
    },
    {
      "id": "empty",
      "description": "Empty, whitespace-only, diacritics-only and tatweel-only input."
    },
    {
      "id": "list",
      "description": "Every entry of the @shifa/testing name lists."
    },
    {
      "id": "full-name",
      "description": "Full synthetic names and their typed variants."
    }
  ],
