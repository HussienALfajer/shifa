{
  "name": "@shifa/dart-testing",
  "version": "0.0.0",
  "private": true,
  "description": "Turborepo task wrapper for the Dart package shifa_testing (see pubspec.yaml).",
  "scripts": {
    "typecheck": "node ../../scripts/dart.mjs dart analyze --fatal-infos",
