        "table": "support_access_grant",
        "name": "support_access_grant_reason_check",
        "value": "char_length(\"reason\") between 10 and 500 and \"reason\" = btrim(\"reason\")",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "support_access_grant",
        "name": "support_access_grant_duration_check",
        "value": "\"expires_at\" > \"opened_at\" and \"expires_at\" <= \"opened_at\" + interval '4 hours'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "support_access_grant",
        "name": "support_access_grant_end_check",
        "value": "(\"ended_at\" is null) = (\"end_reason\" is null)\n          and (\"end_reason\" is null or \"end_reason\" in ('admin', 'owner', 'expiry'))\n          and ((\"end_reason\" = 'expiry') = (\"end_reason\" is not null and \"ended_by\" is null))",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "support_access_grant",
        "name": "support_access_grant_names_check",
        "value": "char_length(\"admin_name\") between 1 and 200\n          and (\"ended_by_name\" is null or char_length(\"ended_by_name\") between 1 and 200)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "support_access_grant",
        "name": "support_access_grant_handoff_check",
        "value": "\"handoff_token_hash\" is null or \"handoff_token_hash\" ~ '^[0-9a-f]{64}$'",
        "entityType": "checks"
      }
